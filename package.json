{
  "name": "deedquest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "cloudflare:check": "pnpm build && wrangler deploy --dry-run",
    "cloudflare:dev": "pnpm build && wrangler dev",
    "cloudflare:deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vercel/node": "^5.3.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.6"
}
