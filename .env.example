# Only needed for deployed online rooms. Never prefix these secrets with VITE_.
# Create a Free Redis database at https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-private-rest-token

# With neither variable set, `pnpm dev` uses local file storage.
# Vercel deployments always require the database; no ephemeral fallback is used.
# Public advertising settings. Ads stay off until a real sponsor or approved account is configured.
VITE_AD_MODE=off
VITE_CONTACT_EMAIL=
VITE_SPONSOR_NAME=
VITE_SPONSOR_TEXT=
VITE_SPONSOR_URL=
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
